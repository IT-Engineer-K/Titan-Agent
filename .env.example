# Copy this file to `.env` (never commit `.env` to Git)
# Option 1: Bot API (supports reading messages AND sending messages)
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_CHANNEL_ID=your_default_channel_id_here

# Option 2: Webhook URL (send-only notifications)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
